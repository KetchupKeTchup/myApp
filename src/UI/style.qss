/* --- Main Window --- */
QWidget#central_widget {
    background-color: #121212; 
    color: white; 
    border-radius: 10px;
}

/* --- left sidebar --- */
QFrame#sidebar {
    background-color: #1a1a1a; border-right: 1px solid #2a2a2a
}
/* --- Кнопки--- */
QPushButton#btn_food, QPushButton#btn_food_viev {
    border: none;
    border-left: 3px solid #ff7043; 
    background-color: transparent; 
    font-size: 24px; 
    margin: 0px;
    padding: 0px;
}

/* --- Секція Харчування (FoodUi) --- */


QLabel#calories_main {
    font-size: 64px; 
    font-weight: bold; 
    color: #ffffff;
}

QLabel#calories_subtitle {
    font-size: 18px; 
    color: #888888;
}

QProgressBar#calories_progress { 
    background-color: #2a2a2a; 
    border-radius: 2px; 
}
QProgressBar#calories_progress::chunk { 
    background-color: #ff7043; 
    border-radius: 2px; 
}

QLineEdit#food_input {
    background-color: #1e1e1e; 
    border: 1px solid #333333;
    border-radius: 22px; 
    padding-left: 20px; 
    color: #ffffff; 
    font-size: 14px;
}
QLineEdit#input_style{
    background-color: #2a2a2a; 
    border: 1px solid #444; 
    border-radius: 5px; 
    padding: 5px;
}

QPushButton#btn_add {
    background-color: #1e1e1e; 
    border: 1px solid #333333;
    border-radius: 22px; 
    color: #ff7043; 
    font-size: 16px; 
    font-weight: bold;
    padding-left: 20px; 
    padding-right: 20px;
}
QPushButton#btn_add:hover { 
    background-color: #2a2a2a; 
}



/* -------------------------------QScrollArea--------------------------------- */

/* Стилізація контейнера QScrollArea */

QWidget#meals_container {
    background-color: #121212; 
}


/* -------------------------------Макроелементи--------------------------------- */

QWidget#macro_conteiner {
    background: qlineargradient(
        x1:1, y1:0.2, 
        x2:0.2, y2:1, 
        stop:0 transparent, 
        stop:0.25 #1a1a1a,
        stop:0.5 #2a2a2a,
        stop:0.75 #3a3a3a,
        stop:1 #636666
        );
    margin: 0px; 
    border-radius: 25px;
}

QLabel[cssClass="macro_name"] {
    color: #dad0d0; 
    font-weight: bold;
    font-size: 16px;
    background-color: transparent;
}

QLabel[cssClass="macro_val"] {
    color: #ffffff; 
    font-size: 24px; 
    font-weight: bold;
    background-color: transparent;
}


/* -------------------------------Таблиця--------------------------------- */
QTableWidget {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #333333;
    border-radius: 8px;
    gridline-color: #2a2a2a; /* Колір сітки */
    font-size: 14px;
}

/* Клітинки таблиці */
QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid #2a2a2a;
}

/* Виділений рядок  */
QTableWidget::item:selected {
    background-color: #2c2c2c;
    color: #ff7043;
}

/* Заголовки колонок  */
QHeaderView::section {
    background-color: #222222;
    color: #888888;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #333333;
    font-weight: bold;
    font-size: 12px;
}





QTableView {
    border-radius: 5px;
    background-color: #2b2b2b;      /* Колір фону порожнього місця */
    alternate-background-color: #323232; /* Колір кожного другого рядка (зебра) */
    border: 1px solid #444444;      /* Зовнішня рамка таблиці */
    color: #e0e0e0;                 /* Колір тексту */
    gridline-color: #444444;        /* Колір сітки (якщо ви її увімкнете) */
    selection-background-color: #c31111; /* Колір виділеного рядка (ваш червоний) */
}

/* 2. Стиль комірок (item) */
QTableView::item {
    padding-left: 10px;             /* Відступ тексту від лівого краю комірки */
    padding-right: 10px;
    border-bottom: 1px solid #3a3a3a; /* Нижня лінія для кожного рядка замість повної сітки */
}

/* 3. Коли користувач наводить мишку на рядок */
QTableView::item:hover {
    background-color: #3e3e3e;      /* Легке підсвічування сірим */
}

/* 4. Коли користувач клікнув на рядок */
QTableView::item:selected {
    background-color: #c31111;      /* Червоний фон при виділенні */
    color: white;                   /* Білий текст для контрасту */
    border: none;                   /* Прибираємо границі всередині виділення */
}

/* 5. Стиль верхніх заголовків (Колонки) */
QHeaderView::section {
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    padding: 8px;                   /* Відступи всередині заголовка */
    border-radius: 5px;
    margin-bottom: 5px;

}

