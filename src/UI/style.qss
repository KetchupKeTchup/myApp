/* --- Main Window --- */
QWidget#central_widget {
    background-color: #121212; 
    color: white; 
    border-radius: 10px;
}

/* --- Секція Харчування (FoodUi) --- */


QLabel#calories_main {
    font-size: 64px; 
    font-weight: bold; 
    color: #ffffff;
}

QLabel#calories_subtitle {
    font-size: 18px; 
    color: #888888;
}

QProgressBar#calories_progress { 
    background-color: #2a2a2a; 
    border-radius: 2px; 
}
QProgressBar#calories_progress::chunk { 
    background-color: #ff7043; 
    border-radius: 2px; 
}

QLineEdit#food_input {
    background-color: #1e1e1e; 
    border: 1px solid #333333;
    border-radius: 22px; 
    padding-left: 20px; 
    color: #ffffff; 
    font-size: 14px;
}
QLineEdit#input_style{
    background-color: #2a2a2a; 
    border: 1px solid #444; 
    border-radius: 5px; 
    padding: 5px;
}

QPushButton#btn_add {
    background-color: #1e1e1e; 
    border: 1px solid #333333;
    border-radius: 22px; 
    color: #ff7043; 
    font-size: 16px; 
    font-weight: bold;
    padding-left: 20px; 
    padding-right: 20px;
}
QPushButton#btn_add:hover { 
    background-color: #2a2a2a; 
}



/* -------------------------------QScrollArea--------------------------------- */

/* Стилізація контейнера QScrollArea */
QScrollArea#scroll_area{
    border: 5px solid #3c3939; 
    border-radius: 25px;
    background-color: #121212; 
    padding: 15px;
}
QWidget#meals_container {
    background-color: #121212; 
}


/* -------------------------------Макроелементи--------------------------------- */

QWidget#macro_conteiner {
    background: qlineargradient(
        x1:0, y1:0, 
        x2:1, y2:1, 
        stop:0 #8b8a8a, 
        stop:1 #ac590c);
    margin: 0px; 
    border-radius: 25px;
}

QLabel[cssClass="macro_name"] {
    color: #dad0d0; 
    font-weight: bold;
    font-size: 16px;
    background-color: transparent;
}

QLabel[cssClass="macro_val"] {
    color: #ffffff; 
    font-size: 24px; 
    font-weight: bold;
    background-color: transparent;
}


/* -------------------------------Таблиця--------------------------------- */
QTableWidget {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #333333;
    border-radius: 8px;
    gridline-color: #2a2a2a; /* Колір сітки */
    font-size: 14px;
}

/* Клітинки таблиці */
QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid #2a2a2a;
}

/* Виділений рядок  */
QTableWidget::item:selected {
    background-color: #2c2c2c;
    color: #ff7043;
}

/* Заголовки колонок  */
QHeaderView::section {
    background-color: #222222;
    color: #888888;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #333333;
    font-weight: bold;
    font-size: 12px;
}